rules_version = '2';
// La app accede a Firestore SOLO desde el servidor con la cuenta de servicio (Admin SDK, que no pasa por estas reglas).
// Por eso se bloquea todo acceso directo desde navegadores o apps.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
